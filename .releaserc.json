{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "back/build/libs/*.jar",
            "name": "microcrm-back-${nextRelease.gitTag}.jar",
            "label": "Backend JAR (${nextRelease.gitTag})"
          },
          {
            "path": "microcrm-front.zip",
            "name": "microcrm-front-${nextRelease.gitTag}.zip",
            "label": "Frontend build (${nextRelease.gitTag})"
          }
        ]
      }
    ]
  ]
}
